<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="eConsumo IA"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_periodo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ahora: --"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_fechas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ciclo"
        android:textColor="#B0BEC5"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_euros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- €"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_kwh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="-- kWh"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_prediccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#80DEEA"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_grafica"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:scaleType="fitXY"
        android:contentDescription="Consumo diario" />

</LinearLayout>
